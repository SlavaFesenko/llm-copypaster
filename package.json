{
  "name": "llm-copypaster",
  "displayName": "llm-copypaster",
  "description": "Added Paste from Editor Feature",
  "version": "0.7.3",
  "repository": {
    "type": "git",
    "url": "[https://github.com/SlavaFesenko/llm-copypaster.git](https://github.com/SlavaFesenko/llm-copypaster.git)"
  },
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "llm-copypaster.copyThisFileAsLlmContext",
        "title": "LLM Copypaster: Copy This File"
      },
      {
        "command": "llm-copypaster.copyThisTabGroupAsLlmContext",
        "title": "LLM Copypaster: Copy This Tab Group Files"
      },
      {
        "command": "llm-copypaster.copyPinnedFilesInActiveTabGroupAsLlmContext",
        "title": "LLM Copypaster: Copy This Tab Group Pinned Files"
      },
      {
        "command": "llm-copypaster.copyAllOpenFilesAsLlmContext",
        "title": "LLM Copypaster: Copy All Files"
      },
      {
        "command": "llm-copypaster.copyAllPinnedFilesAsLlmContext",
        "title": "LLM Copypaster: Copy All Pinned Files"
      },
      {
        "command": "llm-copypaster.copySelectedExplorerItemsAsLlmContext",
        "title": "LLM Copypaster: Copy File(s)"
      },
      {
        "command": "llm-copypaster.openSelectedFiles",
        "title": "Open Selected Files"
      },
      {
        "command": "llm-copypaster.openSelectedFilesInNewTabGroup",
        "title": "Open Selected Files In NEW Tab Group"
      },
      {
        "command": "llm-copypaster.openSelectedFilesInActiveTabGroup",
        "title": "Open Selected Files In ACTIVE Tab Group"
      },
      {
        "command": "llm-copypaster.openSelectedFilesInTabGroup",
        "title": "Open Selected Files In <SELECT> Tab Group"
      },
      {
        "command": "llm-copypaster.applyClipboardToFiles",
        "title": "LLM Copypaster: Paste Clipboard to Files"
      },
      {
        "command": "llm-copypaster.forceCloseAllTabs",
        "title": "Force Close All Tabs"
      },
      {
        "command": "llm-copypaster.forceCloseTabsInTabGroup",
        "title": "Force Close Tabs in Tab Group"
      },
      {
        "command": "llm-copypaster.pinAllTabs",
        "title": "Pin All Tabs"
      },
      {
        "command": "llm-copypaster.pinTabsInTabGroup",
        "title": "Pin Tabs in Tab Group"
      },
      {
        "command": "llm-copypaster.unpinAllTabs",
        "title": "Unpin All Tabs"
      },
      {
        "command": "llm-copypaster.unpinTabsInTabGroup",
        "title": "Unpin Tabs in Tab Group"
      },
      {
        "command": "llm-copypaster.lsConfig",
        "title": "ls config"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "llm-copypaster.copySelectedExplorerItemsAsLlmContext",
          "when": "explorerResourceIsFolder || resourceScheme == file",
          "group": "1-navigation@1"
        },
        {
          "command": "llm-copypaster.openSelectedFiles",
          "when": "explorerResourceIsFolder || resourceScheme == file",
          "group": "1-navigation@2"
        },
        {
          "command": "llm-copypaster.openSelectedFilesInNewTabGroup",
          "when": "explorerResourceIsFolder || resourceScheme == file",
          "group": "1-navigation@3"
        },
        {
          "command": "llm-copypaster.openSelectedFilesInActiveTabGroup",
          "when": "explorerResourceIsFolder || resourceScheme == file",
          "group": "1-navigation@4"
        },
        {
          "command": "llm-copypaster.openSelectedFilesInTabGroup",
          "when": "explorerResourceIsFolder || resourceScheme == file",
          "group": "1-navigation@5"
        }
      ],
      "editor/context": [
        {
          "command": "llm-copypaster.copyThisFileAsLlmContext",
          "when": "resourceScheme == file",
          "group": "0-navigation@1"
        },
        {
          "command": "llm-copypaster.copyThisTabGroupAsLlmContext",
          "when": "resourceScheme == file",
          "group": "0-navigation@2"
        },
        {
          "command": "llm-copypaster.copyPinnedFilesInActiveTabGroupAsLlmContext",
          "when": "resourceScheme == file",
          "group": "0-navigation@3"
        },
        {
          "command": "llm-copypaster.copyAllOpenFilesAsLlmContext",
          "when": "resourceScheme == file",
          "group": "0-navigation@4"
        },
        {
          "command": "llm-copypaster.copyAllPinnedFilesAsLlmContext",
          "when": "resourceScheme == file",
          "group": "0-navigation@5"
        },
        {
          "command": "llm-copypaster.applyClipboardToFiles",
          "when": "resourceScheme == file",
          "group": "0-navigation@6"
        }
      ],
      "editor/title/context": [
        {
          "command": "llm-copypaster.pinTabsInTabGroup",
          "when": "resourceScheme == file",
          "group": "0-navigation@1"
        },
        {
          "command": "llm-copypaster.unpinTabsInTabGroup",
          "when": "resourceScheme == file",
          "group": "0-navigation@2"
        },
        {
          "command": "llm-copypaster.pinAllTabs",
          "when": "resourceScheme == file",
          "group": "0-navigation@3"
        },
        {
          "command": "llm-copypaster.unpinAllTabs",
          "when": "resourceScheme == file",
          "group": "0-navigation@4"
        },
        {
          "command": "llm-copypaster.forceCloseAllTabs",
          "when": "resourceScheme == file",
          "group": "0-navigation@5"
        },
        {
          "command": "llm-copypaster.forceCloseTabsInTabGroup",
          "when": "resourceScheme == file",
          "group": "0-navigation@6"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "llmCopypaster.promptWorkbench",
          "name": "Prompt Workbench"
        }
      ]
    },
    "keybindings": [
      {
        "command": "llm-copypaster.applyClipboardToFiles",
        "key": "alt+1",
        "when": "editorTextFocus"
      },
      {
        "command": "llm-copypaster.validateClipboardPayload",
        "key": "alt+2",
        "when": "editorTextFocus"
      },
      {
        "command": "llm-copypaster.sanitizeClipboardPayload",
        "key": "alt+3",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "json-diff-ts": "^4.9.1",
    "jsonc-parser": "^3.3.1",
    "liquidjs": "^10.24.0",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.17",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.109.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  }
}
