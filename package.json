{
  "name": "llm-copypaster",
  "displayName": "LLM Copypaster",
  "description": "Copy project and file context with reusable instructions to any AI via clipboard, then apply the AI response back to your files.",
  "version": "0.14.0",
  "repository": {
    "type": "git",
    "url": "[https://github.com/SlavaFesenko/llm-copypaster.git](https://github.com/SlavaFesenko/llm-copypaster.git)"
  },
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "llm",
    "ai",
    "chatgpt",
    "claude",
    "cursor",
    "copilot",
    "prompt-engineering",
    "context-engineering",
    "project-context",
    "file-context",
    "code-context",
    "multi-file-context",
    "codebase-context",
    "prompt-context",
    "project-instructions",
    "clipboard",
    "copy-to-clipboard",
    "apply-ai-output",
    "patch-files",
    "ai-coding"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "llm-copypaster.copyThisFileAsLlmContext",
        "title": "LLM Copypaster: Copy This File"
      },
      {
        "command": "llm-copypaster.copyThisTabGroupAsLlmContext",
        "title": "LLM Copypaster: Copy Tab Group Files"
      },
      {
        "command": "llm-copypaster.copyPinnedFilesInActiveTabGroupAsLlmContext",
        "title": "LLM Copypaster: Copy Tab Group 📌 Files"
      },
      {
        "command": "llm-copypaster.copyUnpinnedFilesInActiveTabGroupAsLlmContext",
        "title": "LLM Copypaster: Copy Tab Group ❗📌 Files"
      },
      {
        "command": "llm-copypaster.copyAllOpenFilesAsLlmContext",
        "title": "Copy All Files"
      },
      {
        "command": "llm-copypaster.copyAllPinnedFilesAsLlmContext",
        "title": "Copy All 📌 Files"
      },
      {
        "command": "llm-copypaster.copyAllUnpinnedFilesAsLlmContext",
        "title": "Copy All ❗📌 Files"
      },
      {
        "command": "llm-copypaster.copySelectedExplorerItemsAsLlmContext",
        "title": "LLM Copypaster: Copy Selected File(s)"
      },
      {
        "command": "llm-copypaster.applyClipboardToFiles",
        "title": "Paste Clipboard to Files"
      },
      {
        "command": "llm-copypaster.replaceClipboardByInstruction",
        "title": "Replace Clipboard By Quick Instructions"
      },
      {
        "command": "llm-copypaster.prependInstructionToClipboard",
        "title": "Prepend Quick Instructions To Clipboard"
      },
      {
        "command": "llm-copypaster.clearOutsideWorkspaceCache",
        "title": "[DEBUG] Clear App Cache"
      },
      {
        "command": "llm-copypaster.lsConfig",
        "title": "[DEBUG] Open Config Details"
      }
    ],
    "submenus": [
      {
        "id": "llm-copypaster.editorContext.other",
        "label": "LLM Copypaster: Other..."
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "llm-copypaster.copySelectedExplorerItemsAsLlmContext",
          "when": "explorerResourceIsFolder || resourceScheme == file",
          "group": "1-navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "llm-copypaster.copyThisFileAsLlmContext",
          "when": "resourceScheme == file",
          "group": "0-navigation@1"
        },
        {
          "command": "llm-copypaster.copyThisTabGroupAsLlmContext",
          "when": "resourceScheme == file",
          "group": "0-navigation@2"
        },
        {
          "command": "llm-copypaster.copyPinnedFilesInActiveTabGroupAsLlmContext",
          "when": "resourceScheme == file",
          "group": "0-navigation@3"
        },
        {
          "command": "llm-copypaster.copyUnpinnedFilesInActiveTabGroupAsLlmContext",
          "when": "resourceScheme == file",
          "group": "0-navigation@4"
        },
        {
          "submenu": "llm-copypaster.editorContext.other",
          "when": "resourceScheme == file",
          "group": "0-navigation@5"
        }
      ],
      "llm-copypaster.editorContext.other": [
        {
          "command": "llm-copypaster.copyAllOpenFilesAsLlmContext",
          "when": "resourceScheme == file",
          "group": "0-navigation@1"
        },
        {
          "command": "llm-copypaster.copyAllPinnedFilesAsLlmContext",
          "when": "resourceScheme == file",
          "group": "0-navigation@2"
        },
        {
          "command": "llm-copypaster.copyAllUnpinnedFilesAsLlmContext",
          "when": "resourceScheme == file",
          "group": "0-navigation@3"
        },
        {
          "command": "llm-copypaster.replaceClipboardByInstruction",
          "when": "resourceScheme == file",
          "group": "0-navigation@4"
        },
        {
          "command": "llm-copypaster.prependInstructionToClipboard",
          "when": "resourceScheme == file",
          "group": "0-navigation@5"
        },
        {
          "command": "llm-copypaster.applyClipboardToFiles",
          "when": "resourceScheme == file",
          "group": "0-navigation@6"
        },
        {
          "command": "llm-copypaster.clearOutsideWorkspaceCache",
          "when": "resourceScheme == file",
          "group": "0-navigation@7"
        },
        {
          "command": "llm-copypaster.lsConfig",
          "when": "resourceScheme == file",
          "group": "0-navigation@8"
        }
      ]
    },
    "keybindings": [
      {
        "command": "llm-copypaster.applyClipboardToFiles",
        "key": "ctrl+alt+v",
        "when": "editorTextFocus"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          "llm-copypaster.jsonc"
        ],
        "url": "./llm-copypaster.schema.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "postcompile": "node ./scripts/generate-json-schema.js",
    "generate:json-schema": "node ./scripts/generate-json-schema.js",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "json-diff-ts": "^4.9.1",
    "jsonc-parser": "^3.3.1",
    "liquidjs": "^10.24.0",
    "lodash": "^4.17.21",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.17",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.109.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  }
}
