{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "llm-copypaster.schema.json",
  "title": "LLM Copypaster Config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "configVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "nonOverrideableSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowOutsideWorkspaceRead": {
          "type": "boolean"
        },
        "allowOutsideWorkspaceWrite": {
          "type": "boolean"
        },
        "vitalParsingAnchors": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "PROMPT_DELIMITER_ANCHOR": {
              "type": "string",
              "minLength": 1
            },
            "CODE_LISTING_HEADER_ANCHOR": {
              "type": "string",
              "minLength": 1
            },
            "FILE_STATUS_ANCHOR": {
              "type": "string",
              "minLength": 1
            },
            "FILE_EDITED_FULL_ANCHOR": {
              "type": "string",
              "minLength": 1
            },
            "FILE_CREATED_ANCHOR": {
              "type": "string",
              "minLength": 1
            },
            "FILE_DELETED_ANCHOR": {
              "type": "string",
              "minLength": 1
            },
            "END_OF_OUTPUT_ANCHOR": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    "coreSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skipInstructions": {
          "type": "boolean"
        },
        "skipCodeListings": {
          "type": "boolean"
        },
        "ideToLlm": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "skipPromptSizeStatsInCopyNotification": {
              "type": "boolean"
            },
            "charsPerToken": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "linesMaxToShowWarning": {
              "type": "integer",
              "minimum": 0
            },
            "tokensMaxToShowWarning": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "llmToIde": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "skipPromptSizeStatsInCopyNotification": {
              "type": "boolean"
            },
            "charsPerToken": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "linesMaxToShowWarning": {
              "type": "integer",
              "minimum": 0
            },
            "tokensMaxToShowWarning": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "postFilePatchActions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enableSaveAfterFilePatch": {
              "type": "boolean"
            },
            "enableLintingAfterFilePatch": {
              "type": "boolean"
            },
            "enableOpeningPatchedFilesInEditor": {
              "type": "boolean"
            }
          }
        },
        "instructionsAndVariables": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "instructionsById": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "skip": {
                    "type": "boolean"
                  },
                  "showInOverrideMode": {
                    "type": "boolean"
                  },
                  "showInQuickInstructionMode": {
                    "type": "boolean"
                  }
                }
              }
            },
            "sharedVariablesById": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": true
            },
            "sharedReferenceVariablesById": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "llmToIdeSanitizationRulesById": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "regexPattern": {
                "type": "string",
                "minLength": 1
              },
              "replaceWith": {
                "type": "string"
              },
              "skipForLanguages": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "skipForPaths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "overridesById": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "shouldBeSkipped": {
            "type": "boolean"
          },
          "coreSettings": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "skipInstructions": {
                "type": "boolean"
              },
              "skipCodeListings": {
                "type": "boolean"
              },
              "ideToLlm": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "skipPromptSizeStatsInCopyNotification": {
                    "type": "boolean"
                  },
                  "charsPerToken": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "linesMaxToShowWarning": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "tokensMaxToShowWarning": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "llmToIde": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "skipPromptSizeStatsInCopyNotification": {
                    "type": "boolean"
                  },
                  "charsPerToken": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "linesMaxToShowWarning": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "tokensMaxToShowWarning": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "postFilePatchActions": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enableSaveAfterFilePatch": {
                    "type": "boolean"
                  },
                  "enableLintingAfterFilePatch": {
                    "type": "boolean"
                  },
                  "enableOpeningPatchedFilesInEditor": {
                    "type": "boolean"
                  }
                }
              },
              "instructionsAndVariables": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "instructionsById": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "path": {
                          "type": "string",
                          "minLength": 1
                        },
                        "skip": {
                          "type": "boolean"
                        },
                        "showInOverrideMode": {
                          "type": "boolean"
                        },
                        "showInQuickInstructionMode": {
                          "type": "boolean"
                        }
                      }
                    }
                  },
                  "sharedVariablesById": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": true
                  },
                  "sharedReferenceVariablesById": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                }
              },
              "llmToIdeSanitizationRulesById": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "regexPattern": {
                      "type": "string",
                      "minLength": 1
                    },
                    "replaceWith": {
                      "type": "string"
                    },
                    "skipForLanguages": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "skipForPaths": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
