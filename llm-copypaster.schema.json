{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "llm-copypaster.schema.json",
  "title": "LLM Copypaster Config",
  "type": "object",
  "properties": {
    "nonOverrideableSettings": {
      "type": "object",
      "properties": {
        "allowOutsideWorkspaceRead": {
          "type": "boolean"
        },
        "allowOutsideWorkspaceWrite": {
          "type": "boolean"
        },
        "vitalParsingAnchors": {
          "type": "object",
          "properties": {
            "PROMPT_DELIMITER_ANCHOR": {
              "type": "string"
            },
            "CODE_LISTING_HEADER_ANCHOR": {
              "type": "string"
            },
            "FILE_STATUS_ANCHOR": {
              "type": "string"
            },
            "FILE_EDITED_FULL_ANCHOR": {
              "type": "string"
            },
            "FILE_CREATED_ANCHOR": {
              "type": "string"
            },
            "FILE_DELETED_ANCHOR": {
              "type": "string"
            },
            "END_OF_OUTPUT_ANCHOR": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "PROMPT_DELIMITER_ANCHOR",
            "CODE_LISTING_HEADER_ANCHOR",
            "FILE_STATUS_ANCHOR",
            "FILE_EDITED_FULL_ANCHOR",
            "FILE_CREATED_ANCHOR",
            "FILE_DELETED_ANCHOR",
            "END_OF_OUTPUT_ANCHOR"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "allowOutsideWorkspaceRead",
        "allowOutsideWorkspaceWrite",
        "vitalParsingAnchors"
      ],
      "additionalProperties": false
    },
    "coreSettings": {
      "type": "object",
      "properties": {
        "skipInstructions": {
          "type": "boolean"
        },
        "skipCodeListings": {
          "type": "boolean"
        },
        "ideToLlm": {
          "type": "object",
          "properties": {
            "skipPromptSizeStatsInCopyNotification": {
              "type": "boolean"
            },
            "charsPerToken": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "linesMaxToShowWarning": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "tokensMaxToShowWarning": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "skipPromptSizeStatsInCopyNotification",
            "charsPerToken",
            "linesMaxToShowWarning",
            "tokensMaxToShowWarning"
          ],
          "additionalProperties": false
        },
        "llmToIde": {
          "type": "object",
          "properties": {
            "skipPromptSizeStatsInCopyNotification": {
              "type": "boolean"
            },
            "charsPerToken": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "linesMaxToShowWarning": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "tokensMaxToShowWarning": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "skipPromptSizeStatsInCopyNotification",
            "charsPerToken",
            "linesMaxToShowWarning",
            "tokensMaxToShowWarning"
          ],
          "additionalProperties": false
        },
        "postFilePatchActions": {
          "type": "object",
          "properties": {
            "enableSaveAfterFilePatch": {
              "type": "boolean"
            },
            "enableLintingAfterFilePatch": {
              "type": "boolean"
            },
            "enableOpeningPatchedFilesInEditor": {
              "type": "boolean"
            }
          },
          "required": [
            "enableSaveAfterFilePatch",
            "enableLintingAfterFilePatch",
            "enableOpeningPatchedFilesInEditor"
          ],
          "additionalProperties": false
        },
        "instructionsAndVariables": {
          "type": "object",
          "properties": {
            "instructionsById": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "skip": {
                    "type": "boolean"
                  },
                  "showInOverrideMode": {
                    "type": "boolean"
                  },
                  "showInQuickInstructionMode": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "path",
                  "skip",
                  "showInOverrideMode",
                  "showInQuickInstructionMode"
                ],
                "additionalProperties": false
              }
            },
            "sharedVariablesById": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            "sharedReferenceVariablesById": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "instructionsById",
            "sharedVariablesById",
            "sharedReferenceVariablesById"
          ],
          "additionalProperties": false
        },
        "llmToIdeSanitizationRulesById": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "regexPattern": {
                "type": "string",
                "minLength": 1
              },
              "replaceWith": {
                "type": "string"
              },
              "skipForLanguages": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "skipForPaths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "regexPattern",
              "replaceWith",
              "skipForLanguages",
              "skipForPaths"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "skipInstructions",
        "skipCodeListings",
        "ideToLlm",
        "llmToIde",
        "postFilePatchActions",
        "instructionsAndVariables",
        "llmToIdeSanitizationRulesById"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "nonOverrideableSettings",
    "coreSettings"
  ],
  "additionalProperties": false
}
