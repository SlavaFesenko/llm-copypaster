// Workspace config file for LLM Copypaster based on LlmCopypasterUserConfig (TODO: when release ext - add url of the file)
// NOTE: if you don’t want to “show” the file in git, add `/llm-copypaster.jsonc` to `.git/info/exclude`
// todo: show warning if config can't be parsed, let's say when required param (profile version) was not defined or so
{
  "baseSettings": {
    "promptInstructionConfig": {
      "subInstructionsById": {
        "llm-response-rules-prompt": {
          "relativePathToSubInstruction": "C:\\Users\\Viacheslav_Fesenko\\Documents\\Coding Prompts\\llm-response-rules-prompt.md",
          "ignore": false,
        },
        "web-git-prompt": {
          "relativePathToSubInstruction": "C:\\Users\\Viacheslav_Fesenko\\Documents\\Coding Prompts\\web-git-prompt.md",
          "ignore": false,
        },
      },
      "sharedVariablesById": {
        "WEB_GIT_PROMPT_IGNORE": "LLM_CPP_CFG.promptInstructionConfig.subInstructionsById.web-git-prompt.ignore",
        "WEB_GIT_PROMPT_NAME": "Web Git Prompt",
        "BRANCH_NAME": "master",
        "RAW_GITHUB_BASE_URL": "https://raw.githubusercontent.com/",
        "BLOB_GITHUB_BASE_URL": "https://github.com/",
        "AUTHOR_REPO": "SlavaFesenko/llm-copypaster/",
        "IS_REMOTE_FILE_EDIT_ALLOWED": "true",
      },
    },
  },
  "profilesById": {
    "Disallow REMOTE_FILE_EDIT": {
      "description": "Disallow REMOTE_FILE_EDIT - make them just readonly",
      "version": "1", // todo mark version as optional
      "profileSettingsConfig": {
        "promptInstructionConfig": {
          "sharedVariablesById": {
            "IS_REMOTE_FILE_EDIT_ALLOWED": "false",
          },
        },
      },
    },

    "Remove web-git-prompt": {
      "description": "Remove web-git-prompt from instructions section",
      "version": "1",
      "profileSettingsConfig": {
        "promptInstructionConfig": {
          "subInstructionsById": {
            "web-git-prompt": {
              "relativePathToSubInstruction": "prompts/web-git-prompt.md", // todo: make sure: are -ById copied by object or by props
              "ignore": true,
            },
          },
        },
      },
    },
  },
}
