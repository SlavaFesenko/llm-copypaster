// Workspace config file for LLM Copypaster based on LlmCopypasterUserConfig (TODO: when release ext - add url of the file)
// NOTE: if you don’t want to “show” the file in git, add `/llm-copypaster.jsonc` to `.git/info/exclude`
{
  "presetIndependentSettings": {
    "allowOutsideWorkspaceRead": true,
    "allowOutsideWorkspaceWrite": true,
    "vitalParsingAnchors": {
      "END_OF_OUTPUT_ANCHOR": "## LLM-CPP-EOF-OUTPUT", // set null when there's a trouble with this flag "## LLM-CPP-EOF-OUTPUT"
    },
    "notificationSettings": {
      "configValidation": {
        "suppressWarningIssuesToast": false,
        "suppressRecommendationIssuesToast": false,
        "suppressNoIssuesToast": false,
      },
    },
  },
  "presetDependentSettings": {
    "instructionsSettings": {
      "instructionsById": {
        "codestyle-rules-local": {
          "path": ".user-instructions/codestyle-rules.liquid",
          "skip": false,
          "showInPresetsMode": true,
        },
        // "llm-response-rules": {
        //   "path": "C:\\Users\\Viacheslav_Fesenko\\Documents\\prompting-instructions\\llm-response-rules.liquid",
        //   "skip": false,
        //   "showInPresetsMode": true,
        // },
        "web-git": {
          "path": "C:\\Users\\Viacheslav_Fesenko\\Documents\\prompting-instructions\\web-git.liquid",
          "skip": true,
          "showInPresetsMode": true,
        },
        "forget-response-rules": {
          "path": "C:\\Users\\Viacheslav_Fesenko\\Documents\\prompting-instructions\\quick-instructions\\forget-response-rules.liquid",
          "skip": true,
          "showInQuickInstructionMode": true,
        },
        "return-only-provided-text": {
          "path": "C:\\Users\\Viacheslav_Fesenko\\Documents\\prompting-instructions\\quick-instructions\\return-only-provided-text.liquid",
          "skip": true,
          "showInQuickInstructionMode": true,
        },
      },
      "variablesById": {
        "WEB_GIT_PROMPT_IGNORE": "presetDependentSettings.instructionsSettings.instructionsById.web-git.skip",
        "WEB_GIT_PROMPT_NAME": "Web Git Rules",
        "BRANCH_NAME": "master",
        "RAW_GITHUB_BASE_URL": "https://raw.githubusercontent.com/",
        "BLOB_GITHUB_BASE_URL": "https://github.com/",
        "AUTHOR_REPO": "SlavaFesenko/llm-copypaster/",
        "IS_REMOTE_FILE_EDIT_ALLOWED": "true",
        "KEY_REFERENCE_URLS_RELATIVE_PATHS": "package.json | src/extension.ts | src/config/config-service.ts | src/config/system-config-contracts.ts ",
      },
    },
  },
  "presetsById": {
    "Disallow IS_REMOTE_FILE_EDIT_ALLOWED": {
      "presetDependentSettings": {
        "instructionsSettings": {
          "variablesById": {
            "IS_REMOTE_FILE_EDIT_ALLOWED": "false",
          },
        },
      },
    },

    "Skip web-git-prompt": {
      "presetDependentSettings": {
        "instructionsSettings": {
          "instructionsById": {
            "web-git": {
              "skip": true,
            },
          },
        },
      },
    },

    "Change AUTHOR_REPO": {
      "presetDependentSettings": {
        "instructionsSettings": {
          "variablesById": {
            "AUTHOR_REPO": "AnotherAuthor",
          },
        },
      },
    },
  },
}
